@import url("https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap");

body {
  background-color: #2e2d2d;
}

.grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 30px;
  width: 100%;
  max-width: 850px;
  margin: 120px auto;
  

}

.um {
  border-bottom-left-radius: 50px;
  border-bottom-right-radius: 50px;
  margin-bottom: 50px;
  height: 90px;
  width: 100%;
  max-width: 90%;
  display: flex;
  justify-content: space-between;
}

.jogadordavez{
text-align: center;
color: whitesmoke;
font-size: 40px;
}

.dois {
  border-top-left-radius: 50px;
  border-top-right-radius: 50px;
  margin-top: 7.5%;
  height: 90px;
  width: 100%;
  max-width: 90%;
  display: flex;
  align-items: end;
  justify-content: space-between;
}

#playerInfo{
  display: inherit;
}

#pontosInfo{
  display: inherit;
}

#nome{
  margin-left: 30px;
}

.jogador {
  background-color: #292929;
  color: white;
  margin-left: 5.4%;
}

.mesa {
  background-color: #2E2D2D;
  border-radius: 20px;
}


.carta {
  aspect-ratio: 5.5/6;
  width: 100%;
  position: relative;
  transition: all 400ms ease;
  transform-style: preserve-3d;
}

.face {
  width: 100%;
  height: 100%;
  border-radius: 20px;
  position: absolute;
  background-size: cover;
  background-position: center;
  transition: all 400ms ease;
}

.front {
  transform: rotateY(180deg);
  backface-visibility: hidden;
}

.back {
  background-color: #141414;
  backface-visibility: hidden;
}

.revelar-carta {
  transform: rotateY(180deg);
}

.acertou {
  filter: saturate();
  opacity: 0.5;
}

.popup {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  justify-content: center;
  align-items: center;
}

.popup-content {
    background-color: #fff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
    max-width: 80%;
    text-align: center;
    position: relative;
}

.close {
    position: absolute;
    top: 10px;
    right: 10px;
    font-size: 24px;
    cursor: pointer;
}

.close:hover {
    color: red;
}
