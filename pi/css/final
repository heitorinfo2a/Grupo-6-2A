body {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #092f19;
}

section {
  background-color: #ffffff;
  width: 70%;
  height: 500px;
  border-radius: 10px;
  margin-top: 5%;
  box-shadow: 0px 0px 0px #fff0f0;
  display: flex;
  flex-direction: column;
  align-items: inherit;
  justify-content: inherit;
}

div {
  margin: 180px 0px 150px 0px;
  font-size: 1.5em;
}

button {
  margin: 10px 20px 10px 15px;
  border-radius: 10px;
  background-color: #19a449;
  border: none;
  font-size: 16px;
  padding: 10px 16px;
  text-align: center;
  cursor: pointer;
  color: #ffffff;
}
